{%- comment -%}
  ============================================
  SECTION: Announcement Bar
  PURPOSE: Rotating top bar with multiple messages.
           Each block is an individual announcement that can
           optionally link to a URL. Auto-rotates and offers
           manual prev/next navigation arrows.
  ADDED:   2026-05-25 by MeshPlanet
  ============================================
{%- endcomment -%}

{%- liquid
  assign bar_height = section.settings.height | default: 40
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign autoplay_speed = section.settings.autoplay_speed | default: 5
  assign show_arrows = section.settings.show_arrows
  assign arrow_color = section.settings.arrow_color
  assign total_blocks = section.blocks.size

  # Visibility filters (B2B + country)
  # The section renders only when ALL active filters pass.
  assign should_render = true

  # B2B filter: hide for logged-in B2B (company) customers
  if section.settings.hide_b2b and customer.b2b?
    assign should_render = false
  endif

  # Country filter: comma-separated ISO codes (e.g. "US,CA"). Empty = no filter.
  assign allowed_raw = section.settings.allowed_countries | strip
  if allowed_raw != blank
    assign allowed_countries = allowed_raw | upcase | replace: ' ', '' | split: ','
    assign current_country = localization.country.iso_code | upcase
    unless allowed_countries contains current_country
      assign should_render = false
    endunless
  endif
-%}

{%- if should_render -%}

<style>
  #shopify-section-{{ section.id }} .gw-announcement-bar {
    --gw-ab-height: {{ bar_height }}px;
    --gw-ab-bg: {{ bg_color }};
    --gw-ab-text: {{ text_color }};
    --gw-ab-arrow: {{ arrow_color }};
    background-color: var(--gw-ab-bg);
    color: var(--gw-ab-text);
    height: var(--gw-ab-height);
    width: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 60px;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
    color: var(--gw-ab-text);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__slide a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--gw-ab-arrow);
    cursor: pointer;
    padding: 8px 12px;
    font-size: 16px;
    line-height: 1;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__arrow:hover {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__arrow--prev {
    left: 12px;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__arrow--next {
    right: 12px;
  }

  #shopify-section-{{ section.id }} .gw-announcement-bar__arrow svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} .gw-announcement-bar__slide {
      padding: 0 40px;
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .gw-announcement-bar__arrow {
      padding: 6px 8px;
    }
  }
</style>

{%- if total_blocks > 0 -%}
  <div
    class="gw-announcement-bar"
    role="region"
    aria-label="Announcement Bar"
    data-gw-announcement-bar
    data-autoplay-speed="{{ autoplay_speed | times: 1000 }}"
    data-total-slides="{{ total_blocks }}"
  >
    {%- if show_arrows and total_blocks > 1 -%}
      <button
        type="button"
        class="gw-announcement-bar__arrow gw-announcement-bar__arrow--prev"
        aria-label="Previous announcement"
        data-gw-ab-prev
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.41 16.59 10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"/>
        </svg>
      </button>
    {%- endif -%}

    <div class="gw-announcement-bar__track" data-gw-ab-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_link = false
          if block.settings.enable_link and block.settings.link != blank
            assign has_link = true
          endif
        -%}

        {%- if has_link -%}
          <a
            href="{{ block.settings.link }}"
            class="gw-announcement-bar__slide {% if forloop.first %}is-active{% endif %}"
            data-gw-ab-slide
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </a>
        {%- else -%}
          <div
            class="gw-announcement-bar__slide {% if forloop.first %}is-active{% endif %}"
            data-gw-ab-slide
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if show_arrows and total_blocks > 1 -%}
      <button
        type="button"
        class="gw-announcement-bar__arrow gw-announcement-bar__arrow--next"
        aria-label="Next announcement"
        data-gw-ab-next
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
        </svg>
      </button>
    {%- endif -%}
  </div>

  {%- if total_blocks > 1 -%}
    <script>
      (function () {
        var root = document.querySelector('#shopify-section-{{ section.id }} [data-gw-announcement-bar]');
        if (!root) return;

        var slides = root.querySelectorAll('[data-gw-ab-slide]');
        var prevBtn = root.querySelector('[data-gw-ab-prev]');
        var nextBtn = root.querySelector('[data-gw-ab-next]');
        var speed = parseInt(root.getAttribute('data-autoplay-speed'), 10) || 5000;
        var current = 0;
        var timer = null;

        function goTo(index) {
          slides[current].classList.remove('is-active');
          current = (index + slides.length) % slides.length;
          slides[current].classList.add('is-active');
        }

        function next() { goTo(current + 1); }
        function prev() { goTo(current - 1); }

        function startAutoplay() {
          stopAutoplay();
          timer = setInterval(next, speed);
        }

        function stopAutoplay() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            next();
            startAutoplay();
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            prev();
            startAutoplay();
          });
        }

        // Pause on hover for better UX
        root.addEventListener('mouseenter', stopAutoplay);
        root.addEventListener('mouseleave', startAutoplay);

        // Pause when tab is not visible to save resources
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            stopAutoplay();
          } else {
            startAutoplay();
          }
        });

        startAutoplay();
      })();
    </script>
  {%- endif -%}
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "section-gw-announcement-bar",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40,
      "label": "Bar height"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#000000",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "default": "#ffffff",
      "label": "Arrow color"
    },
    {
      "type": "header",
      "content": "Rotation"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5,
      "label": "Rotation speed",
      "info": "Time each announcement stays visible before changing"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "Show navigation arrows"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "paragraph",
      "content": "Control where and to whom this bar is shown. By default it is hidden from B2B customers and only shown in the United States."
    },
    {
      "type": "checkbox",
      "id": "hide_b2b",
      "default": true,
      "label": "Hide from B2B customers",
      "info": "When enabled, customers logged in to a B2B company account will not see the bar."
    },
    {
      "type": "text",
      "id": "allowed_countries",
      "default": "US",
      "label": "Show only in these countries",
      "info": "Comma-separated ISO country codes (e.g. US, CA, MX). Leave empty to show in all countries."
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Announcement text",
          "default": "<p>Welcome to our store</p>"
        },
        {
          "type": "checkbox",
          "id": "enable_link",
          "default": false,
          "label": "Enable link",
          "info": "When enabled, the whole announcement becomes clickable"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "<p>Free shipping on orders over $50</p>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "<p>New collection available now</p>"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
