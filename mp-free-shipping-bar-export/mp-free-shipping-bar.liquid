{%- comment -%}
  ============================================
  SNIPPET: mp-free-shipping-bar
  PURPOSE: Displays a progress bar in the cart drawer showing how much more
           the customer needs to spend to unlock free shipping.
           Controlled via theme settings > Cart > Free Shipping Bar.
           Renders nothing if threshold is 0 or not set.
  ADDED: 2026-02-24 by MeshPlanet
  ============================================
{%- endcomment -%}

{%- liquid
  # Only show the free shipping bar for customers in the United States
  assign is_us = false
  if localization.country.iso_code == 'US'
    assign is_us = true
  endif

  assign threshold = settings.free_shipping_threshold | default: 0
  if threshold == 0
    # Do not render if threshold is not configured
  else
    assign threshold_cents = threshold | times: 100
    assign cart_total = cart.total_price
    assign remaining_cents = threshold_cents | minus: cart_total

    if remaining_cents <= 0
      assign progress_pct = 100
      assign shipping_unlocked = true
    else
      assign progress_pct = cart_total | times: 100 | divided_by: threshold_cents
      assign shipping_unlocked = false
      assign remaining_amount = remaining_cents | money_without_trailing_zeros
    endif
  endif
-%}

{%- if threshold > 0 and is_us -%}
  <div class="mp-free-shipping-bar">
    <p class="mp-free-shipping-bar__message">
      {%- if shipping_unlocked -%}
        {{ 'content.free_shipping_unlocked' | t }}
      {%- else -%}
        {{ 'content.free_shipping_progress' | t: amount: remaining_amount }}
      {%- endif -%}
    </p>

    <div
      class="mp-free-shipping-bar__track"
      role="progressbar"
      aria-valuenow="{{ progress_pct }}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <div
        class="mp-free-shipping-bar__fill{% if shipping_unlocked %} mp-free-shipping-bar__fill--complete{% endif %}"
        style="--mp-shipping-progress: {{ progress_pct }}%"
      ></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mp-free-shipping-bar {
    padding: 20px 20px 0 20px;
  }

  .mp-free-shipping-bar__message {
    margin: 0 0 8px;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-foreground);
  }

  .mp-free-shipping-bar__track {
    width: 100%;
    height: 4px;
    background-color: rgb(var(--color-foreground-rgb) / 0.12);
    overflow: hidden;
  }

  .mp-free-shipping-bar__fill {
    height: 100%;
    width: var(--mp-shipping-progress, 0%);
    background-color: var(--color-foreground);
    transition: width 0.4s ease;
  }

  .mp-free-shipping-bar__fill--complete {
    background-color: var(--color-foreground);
  }
{% endstylesheet %}
