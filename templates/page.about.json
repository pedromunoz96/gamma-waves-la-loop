    "image_with_text_YUrUJz": {
      "type": "image-with-text",
      "name": "t:sections.image_with_text.name",
      "settings": {
        "row-reverse": "row-reverse",
        "image": "shopify://shop_images/about-img-02.jpg",
        "image_size": "large",
        "show_frame": false,
        "color_scheme": "background-1",
