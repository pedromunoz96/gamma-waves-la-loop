{%- doc -%}
  ============================================
  SNIPPET: Cart Upsell Carousel
  PURPOSE: Renders a horizontal carousel of upsell products inside the cart drawer.
           Products come from each cart item's custom.cart_upsell metafield
           (list.product_reference). Deduplicates and limits to 10.
  ADAPTED FROM: MeshPlanet mutha-theme export (Horizon primitives) for la-lopp-theme.
           - Uses <product-form> (assets/product-form.js) instead of <product-form-component>.
           - Custom CSS scroll-snap carousel instead of <slideshow-component>.
           - Subscribes to PUB_SUB_EVENTS.cartUpdate from pubsub.js for refresh.
  ============================================
{%- enddoc -%}

{%- assign upsell_rendered_ids = '' -%}
{%- assign upsell_count = 0 -%}

{%- comment -%}
  Collect the product IDs already in the cart so we can exclude them from the
  upsell. IDs are wrapped in commas (e.g. ,123,) so a `contains` check can't
  match a substring (,12, won't false-positive against ,123,).
{%- endcomment -%}
{%- assign cart_product_ids = ',' -%}
{%- for item in cart.items -%}
  {%- assign cart_product_ids = cart_product_ids | append: item.product.id | append: ',' -%}
{%- endfor -%}

{%- capture upsell_slides -%}
  {%- for item in cart.items -%}
    {%- assign metafield_value = item.product.metafields.custom.cart_upsell.value -%}
    {%- if metafield_value == blank -%}{%- continue -%}{%- endif -%}

    {%- for upsell_product in metafield_value -%}
      {%- if upsell_count >= 10 -%}{%- break -%}{%- endif -%}
      {%- if upsell_product.available == false -%}{%- continue -%}{%- endif -%}

      {%- comment -%} Skip upsell products that are already in the cart {%- endcomment -%}
      {%- assign upsell_in_cart_check = ',' | append: upsell_product.id | append: ',' -%}
      {%- if cart_product_ids contains upsell_in_cart_check -%}{%- continue -%}{%- endif -%}

      {%- assign upsell_id_str = upsell_product.id | append: '' -%}

      {%- comment -%} Skip duplicates {%- endcomment -%}
      {%- assign is_duplicate = false -%}
      {%- if upsell_rendered_ids contains upsell_id_str -%}
        {%- assign is_duplicate = true -%}
      {%- endif -%}
      {%- if is_duplicate -%}{%- continue -%}{%- endif -%}

      {%- if upsell_rendered_ids == '' -%}
        {%- assign upsell_rendered_ids = upsell_id_str -%}
      {%- else -%}
        {%- assign upsell_rendered_ids = upsell_rendered_ids | append: ',' | append: upsell_id_str -%}
      {%- endif -%}
      {%- assign upsell_count = upsell_count | plus: 1 -%}

      {%- assign variant = upsell_product.selected_or_first_available_variant -%}
      {%- assign product_form_id = 'UpsellForm-' | append: upsell_product.id -%}

      <div class="mp-cart-upsell__slide">
        <div class="mp-cart-upsell__card">
          <product-form class="product-form" data-hide-errors="false">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              </svg>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product', upsell_product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ variant.id }}"
              >
              <input type="hidden" name="quantity" value="1">

              <div class="mp-cart-upsell__card-inner">
                {%- comment -%} Left: image {%- endcomment -%}
                <div class="mp-cart-upsell__left">
                  {%- if upsell_product.featured_image != blank -%}
                    <div class="mp-cart-upsell__image">
                      <img
                        src="{{ upsell_product.featured_image | image_url: width: 200 }}"
                        alt="{{ upsell_product.featured_image.alt | escape }}"
                        width="200"
                        height="{{ 200 | divided_by: upsell_product.featured_image.aspect_ratio | round }}"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                </div>

                {%- comment -%} Right: title/price + variant select + add button {%- endcomment -%}
                <div class="mp-cart-upsell__rigth">
                  <div class="mp-cart-upsell__details">
                    <a href="{{ upsell_product.url }}" class="mp-cart-upsell__title">
                      {{- upsell_product.title -}}
                    </a>
                    {%- if settings.cart_upsell_show_price -%}
                      <span class="mp-cart-upsell__price" data-upsell-price-display>
                        {{- variant.price | money_without_trailing_zeros -}}
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="mp-cart-upsell__actions">
                    {%- if upsell_product.variants.size > 1 -%}
                      {%- if settings.cart_upsell_variant_style == 'buttons' -%}
                        <fieldset class="mp-cart-upsell__variant-buttons" data-upsell-variant-buttons>
                          {%- for v in upsell_product.variants -%}
                            {%- if v.available -%}
                              <label class="mp-cart-upsell__variant-btn-label">
                                <input
                                  type="radio"
                                  name="upsell-variant-{{ upsell_product.id }}"
                                  value="{{ v.id }}"
                                  data-price="{{ v.price | money_without_trailing_zeros }}"
                                  data-upsell-variant-radio
                                  {% if v.id == variant.id %}checked{% endif %}
                                >
                                <span class="mp-cart-upsell__variant-btn-text">
                                  {{- v.title | remove: ' ' -}}
                                </span>
                              </label>
                            {%- endif -%}
                          {%- endfor -%}
                        </fieldset>
                      {%- else -%}
                        <div class="mp-cart-upsell__select-wrap">
                          <select
                            id="UpsellVariant-{{ upsell_product.id }}"
                            name="upsell-variant-{{ upsell_product.id }}"
                            class="mp-cart-upsell__variant-select"
                            data-upsell-variant-select
                            aria-label="{{ 'cart_upsell.select_option' | t: option: upsell_product.options_with_values.first.name }}"
                          >
                            {%- for v in upsell_product.variants -%}
                              {%- if v.available -%}
                                <option
                                  value="{{ v.id }}"
                                  data-price="{{ v.price | money_without_trailing_zeros }}"
                                  {% if v.id == variant.id %}selected{% endif %}
                                >
                                  {{- v.title -}}
                                </option>
                              {%- endif -%}
                            {%- endfor -%}
                          </select>
                          <span class="mp-cart-upsell__select-chevron" aria-hidden="true">
                            {%- render 'icon-caret' -%}
                          </span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}

                    <button
                      type="submit"
                      name="add"
                      class="mp-cart-upsell__add-btn"
                    >
                      <span class="mp-cart-upsell__add-text">
                        {{ 'products.product.add_to_cart' | t }}
                        {%- if settings.cart_upsell_show_price_in_button -%}
                          <span class="mp-cart-upsell__btn-price" data-upsell-btn-price> · {{ variant.price | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                      </span>
                      <span class="mp-cart-upsell__add-added" aria-hidden="true">
                        {%- render 'icon-checkmark' -%}
                      </span>
                    </button>
                  </div>
                </div>
              </div>
            {%- endform -%}
          </product-form>
        </div>
      </div>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if upsell_count > 0 -%}
  <div class="mp-cart-upsell" data-mp-cart-upsell>
    {%- if settings.cart_upsell_title_text != blank -%}
      <p class="mp-cart-upsell__heading">
        {{- settings.cart_upsell_title_text -}}
      </p>
    {%- endif -%}

    <div class="mp-cart-upsell__carousel">
      {%- if settings.cart_upsell_show_arrows -%}
        <button
          type="button"
          class="mp-cart-upsell__arrow mp-cart-upsell__arrow--prev"
          data-mp-cart-upsell-prev
          aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}"
          disabled
        >
          {%- render 'icon-caret-left' -%}
        </button>
      {%- endif -%}

      <div class="mp-cart-upsell__track" data-mp-cart-upsell-track>
        {{ upsell_slides }}
      </div>

      {%- if settings.cart_upsell_show_arrows -%}
        <button
          type="button"
          class="mp-cart-upsell__arrow mp-cart-upsell__arrow--next"
          data-mp-cart-upsell-next
          aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}"
        >
          {%- render 'icon-caret-right' -%}
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- assign per_slide = settings.cart_upsell_cards_per_slide | default: 1 -%}
  {% style %}
    .mp-cart-upsell .mp-cart-upsell__card-inner {
      background-color: {{ settings.cart_upsell_card_bg }};
    }

    {%- if per_slide == 1 -%}
      /* 1 card per slide: leave a peek of the next card */
      .mp-cart-upsell .mp-cart-upsell__slide {
        width: 88%;
      }
    {%- else -%}
      /* N cards per slide: split the visible track width evenly,
         subtracting (N-1) gaps of 12px between them */
      .mp-cart-upsell .mp-cart-upsell__slide {
        width: calc((100% - {{ per_slide | minus: 1 | times: 12 }}px) / {{ per_slide }});
      }
    {%- endif -%}

    .mp-cart-upsell .mp-cart-upsell__title {
      color: {{ settings.cart_upsell_title_color }};
    }

    .mp-cart-upsell .mp-cart-upsell__price {
      color: {{ settings.cart_upsell_price_color }};
    }

    .mp-cart-upsell .mp-cart-upsell__add-btn {
      background-color: {{ settings.cart_upsell_btn_bg }};
      color: {{ settings.cart_upsell_btn_text_color }};
      border-radius: {{ settings.cart_upsell_btn_border_radius }}px;
      {% if settings.cart_upsell_btn_border %}
        border: {{ settings.cart_upsell_btn_border_width }}px solid {{ settings.cart_upsell_btn_border_color }};
      {% else %}
        border: none;
      {% endif %}
    }

    .mp-cart-upsell .mp-cart-upsell__add-btn:hover {
      background-color: {{ settings.cart_upsell_btn_hover_bg }};
      color: {{ settings.cart_upsell_btn_hover_text_color }};
    }

    .mp-cart-upsell .mp-cart-upsell__arrow {
      color: {{ settings.cart_upsell_arrow_color }};
    }
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  /* All styles scoped to .mp-cart-upsell */
  .mp-cart-upsell {
    width: 100%;
    margin-top: auto;
    border-top: 1px solid #D9D9D9;
    border-bottom: 1px solid #D9D9D9;
    padding: 12px 20px;
  }

  .mp-cart-upsell__heading {
    text-transform: uppercase;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1.5px;
    line-height: 16px;
    margin: 12px 12px 0 12px;
  }

  /* ---- Carousel ---- */
  .mp-cart-upsell__carousel {
    position: relative;
  }

  .mp-cart-upsell__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0 12px;
    scrollbar-width: none;
    cursor: grab;
  }

  .mp-cart-upsell__track::-webkit-scrollbar {
    display: none;
  }

  /* While the user drags with the mouse: 1:1 tracking, no snap fight, no
     text/image selection. Placed after .mp-cart-upsell__track so it wins. */
  .mp-cart-upsell__track--dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
    -webkit-user-select: none;
  }

  .mp-cart-upsell__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    /* width is set inline via the per-page style block based on cart_upsell_cards_per_slide */
  }

  /* ---- Arrows ---- */
  .mp-cart-upsell__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    padding: 0;
    transition: opacity 0.2s;
  }

  .mp-cart-upsell__arrow--prev {
    left: 8px;
  }

  .mp-cart-upsell__arrow--next {
    right: 8px;
  }

  .mp-cart-upsell__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .mp-cart-upsell__arrow .icon-caret-left,
  .mp-cart-upsell__arrow .icon-caret-right,
  .mp-cart-upsell__arrow .icon-caret {
    width: 25px;
    height: 25px;
  }

  /* ---- Card ---- */
  .mp-cart-upsell__card product-form,
  .mp-cart-upsell__card form {
    display: block;
    width: 100%;
  }

  .mp-cart-upsell__card-inner {
    display: flex;
    flex-direction: row;
    gap: 24px;
    width: 100%;
    padding: 12px 24px;
    padding-left: 10px;
  }

  .mp-cart-upsell__rigth {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  /* ---- Image ---- */
  .mp-cart-upsell__image {
    width: 96px;
    overflow: hidden;
  }

  .mp-cart-upsell__image img {
    display: block;
    width: 96px;
    height: 96px;
    object-fit: cover;
  }

  /* ---- Details ---- */
  .mp-cart-upsell__details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  @media screen and (max-width: 750px) {
    .mp-cart-upsell__details {
      min-height: 40px;
    }
  }

  .mp-cart-upsell__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    text-decoration: none;
    color: var(--color-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 30px;
  }

  .mp-cart-upsell__price {
    font-size: 12px;
    color: var(--color-foreground);
  }

  /* ---- Actions ---- */
  .mp-cart-upsell__actions {
    display: flex;
    align-items: start;
    flex-direction: column;
    justify-content: space-between;
    margin-top: 10px;
    gap: 8px;
  }

  /* Custom select wrapper */
  .mp-cart-upsell__select-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 0%;
    min-width: 0;
  }

  .mp-cart-upsell__variant-select {
    font-family: var(--font-heading--family);
    font-size: 14px;
    color: var(--color-foreground);
    background: transparent;
    border: none;
    padding: 0 20px 0 0;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mp-cart-upsell__variant-select:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .mp-cart-upsell__select-chevron {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    display: flex;
    width: 14px;
    height: 14px;
    color: var(--color-foreground);
  }

  .mp-cart-upsell__select-chevron svg {
    width: 100%;
    height: 100%;
  }

  /* ---- Variant buttons ---- */
  .mp-cart-upsell__variant-buttons {
    display: flex;
    gap: 8px;
    border: none;
    padding: 0;
    margin: 0;
  }

  .mp-cart-upsell__variant-btn-label {
    position: relative;
    cursor: pointer;
  }

  .mp-cart-upsell__variant-btn-label input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .mp-cart-upsell__variant-btn-text {
    display: inline-block;
    font-family: var(--font-heading--family);
    font-size: 12px;
    line-height: 1;
    padding: 3px 4px;
    border: 1px solid #d4d4d4;
    border-radius: 4px;
    color: #b0b0b0;
    background: transparent;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .mp-cart-upsell__variant-btn-label input[type="radio"]:checked + .mp-cart-upsell__variant-btn-text {
    border-color: #000;
    color: #000;
  }

  .mp-cart-upsell__variant-btn-label:hover .mp-cart-upsell__variant-btn-text {
    border-color: #999;
    color: #666;
  }

  /* ---- Add to cart button ---- */
  .mp-cart-upsell__add-btn {
    flex: 0 0 auto;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    height: auto;
    padding: 11.5px 15.5px;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    transition: background-color 0.2s, color 0.2s;
  }

  .mp-cart-upsell__add-btn.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .mp-cart-upsell__add-text,
  .mp-cart-upsell__add-added {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, transform 0.2s;
  }

  .mp-cart-upsell__add-added {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.7);
  }

  .mp-cart-upsell__add-added .icon-checkmark {
    width: 18px;
    height: 14px;
  }

  .mp-cart-upsell__add-btn[data-added='true'] {
    pointer-events: none;
  }

  .mp-cart-upsell__add-btn[data-added='true'] .mp-cart-upsell__add-text {
    opacity: 0;
  }

  .mp-cart-upsell__add-btn[data-added='true'] .mp-cart-upsell__add-added {
    opacity: 1;
    transform: scale(1);
  }
{% endstylesheet %}
