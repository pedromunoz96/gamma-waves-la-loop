<div class="text-card">
    <div class="text-card__content">
        {%- if year != blank -%}
            <div class="text-card__year h2">{{ year }}</div>
        {%- endif -%}

        {%- if title != blank -%}
            <h3 class="text-card__title h4">{{ title }}</h3>
        {%- endif -%}

        {%- if description != blank -%}
            <div class="text-card__description">{{ description }}</div>
        {%- endif -%}
    </div>
</div>