{% comment %}
		Renders a product card
		Accepts:
		- product_card_product: {Object} Product Liquid object (optional)
		- media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
		- show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
		- show_vendor: {Boolean} Show the product vendor. Default: true
		- show_desc: {Boolean} Show the product vendor. Default: false
		- show_sku: {Boolean} Show sku. Default: false
		- section_id: {String} The ID of the section that contains this card.
		Usage:
	{% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

<link
	rel='preload'
	href='{{ 'section-main-product.css' | asset_url }}'
	as='style'
	onload="this.onload=null;this.rel='stylesheet'"
>
<link
	rel='stylesheet'
	href='{{ 'component-deferred-media.css' | asset_url }}'
	media='all'
>
<link
	rel='preload'
	href='{{ 'quick-add.css' | asset_url }}'
	as='style'
	onload="this.onload=null;this.rel='stylesheet'"
>
{%- if product_card_variant != blank and product_card_variant != null -%}
	{%- liquid 
		assign current_product = product_card_variant
		assign product_title = ''

		if current_product.metafields.custom.variant_title.value != blank and current_product.metafields.custom.variant_title != blank and current_product.metafields.custom
			assign product_title = current_product.metafields.custom.variant_title.value | escape
		else
			if current_product.title != blank
				assign product_title = product_card_product.title | append: ' ' | append: current_product.title | escape
			else
				assign product_title = product_card_product.title | escape
			endif
		endif
	-%}
{%- else -%}
	{%- assign current_product = product_card_product -%}
	{%- assign product_title = product_card_product.title | escape -%}
	{%- assign first_3d_model = product_card_product.media
		| where: 'media_type', 'model'
		| first
	-%}
	{%- if first_3d_model -%}
		{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
		<link
			id='ModelViewerStyle'
			rel='stylesheet'
			href='https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css'
			media='print'
			onload="this.media='all'"
		>
		<link
			id='ModelViewerOverride'
			rel='stylesheet'
			href='{{ 'component-model-viewer-ui.css' | asset_url }}'
			media='print'
			onload="this.media='all'"
		>
	{%- endif -%}
	{%- if first_3d_model -%}
		<script type='application/json' id='ProductJSON-{{ product.id }}'>
			{{ product_card_product.media | where: 'media_type', 'model' | json }}
		</script>
		<script src='{{ 'quick-add.js' | asset_url }}' defer='defer'></script>
		<script src='{{ 'product-model.js' | asset_url }}' defer></script>
	{%- endif -%}
{%- endif -%}
<script src='{{ 'product-form.js' | asset_url }}' defer='defer'></script>
<script src='{{ 'quick-add.js' | asset_url }}' defer='defer'></script>
<div
	class='card-wrapper js-color-swatches-wrapper'
	data-product='{{ product_card_product.handle }}'
>
	<span class='visually-hidden'>{{ product_title }}</span>

	<div
		class='card card--product'
		tabindex='-1'
	>
		<div class='card__inner full-unstyled-link'>
			{%- liquid
				assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio

				if product_card_product.featured_media.aspect_ratio == null
					assign featured_media_aspect_ratio = 1
				endif
			-%}

			<div
				class='media media--transparent media--{{ media_size }} media--hover-effect'
				{%- if media_size == 'landscape' -%}
					style='padding-bottom: 70%;'
				{%- endif -%}
				{%- if media_size == 'portrait' -%}
					style='padding-bottom: 130%;'
				{%- endif -%}
				{%- if media_size == 'square' -%}
					style='padding-bottom: 100%;'
				{%- endif -%}
			>
				{%- liquid 
					assign fit = ''
					if media_fit == 'contain'
						assign fit = 'object-fit: contain;'
					elsif media_fit == 'cover'
						assign fit = 'object-fit: cover;'
					endif
				-%}
				{%- if product_card_variant.metafields.custom.variant_tile_image.value != blank and product_card_variant.metafields.custom.variant_tile_image != blank and product_card_variant.metafields.custom and product_card_variant != blank and product_card_variant != null -%}
					<img 
						src="{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}" 
						alt="{{ product_title }}" 
						srcset="{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=360 360w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=533 533w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=720 720w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=940 940w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=1066 1066w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=1200 1200w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=1400 1400w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=1600 1600w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=1800 1800w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=2000 2000w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=2200 2200w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=2400 2400w, 
							{{ product_card_variant.metafields.custom.variant_tile_image.value | image_url }}&width=2600 2600w" 
						sizes="(min-width: 1100px) 535px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
						loading="lazy" 
						class="motion-reduce media--first" 
						style="{{ fit }}" 
					/>
				{%- elsif product_card_variant.featured_media != blank and product_card_variant != blank and product_card_variant != null -%}
					{%- liquid 
							assign width_ratio = 1
							if product_card_variant.featured_media.width < product_card_variant.featured_media.height or media_size == 'landscape'
								assign width_ratio = 1
							elsif product_card_variant.featured_media.width > product_card_variant.featured_media.height
								assign width_ratio = product_card_variant.featured_media.width | plus: 0.0 | divided_by: product_card_variant.featured_media.height | round: 2
								if media_size == 'portrait'
									assign width_ratio = width_ratio | times: 1.3
								endif
							endif
						-%}
						{%- capture sizes -%}
							(min-width: 1100px) 535px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
						{%- endcapture -%}

						{{
							product_card_variant.featured_media
							| image_url: width: product_card_variant.media.width
							| image_tag:
								loading: 'lazy',
								sizes: sizes,
								widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
								class: 'motion-reduce media--first',
								style: fit,
								width: product_card_variant.featured_media.width,
								height: product_card_variant.featured_media.height
						}}
				{%- else -%}
					{%- if product_card_product.featured_media -%}
						{%- liquid 
							assign width_ratio = 1
							if product_card_product.featured_media.width < product_card_product.featured_media.height or media_size == 'landscape'
								assign width_ratio = 1
							elsif product_card_product.featured_media.width > product_card_product.featured_media.height
								assign width_ratio = product_card_product.featured_media.width | plus: 0.0 | divided_by: product_card_product.featured_media.height | round: 2
								if media_size == 'portrait'
									assign width_ratio = width_ratio | times: 1.3
								endif
							endif
						-%}
						{%- capture sizes -%}
							(min-width: 1100px) 535px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
						{%- endcapture -%}

						{{
							product_card_product.featured_media
							| image_url: width: product_card_product.media.width
							| image_tag:
								loading: 'lazy',
								sizes: sizes,
								widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
								class: 'motion-reduce media--first',
								style: fit,
								width: product_card_product.featured_media.width,
								height: product_card_product.featured_media.height
						}}
						{%- if product_card_product.media[1] != null and show_secondary_image -%}
							{{
								product_card_product.media[1]
								| image_url: width: product_card_product.media[1].width
								| image_tag:
									loading: 'lazy',
									sizes: sizes,
									widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
									class: 'motion-reduce media--first',
									style: fit,
									width: product_card_product.media[1].width,
									height: product_card_product.media[1].height
							}}
						{%- endif -%}
					{%- else -%}
						{% liquid
							assign card_index = '1'

							if collection_index != blank
								assign card_index = collection_index
							endif
						%}
						{{
							'collection-'
							| append: card_index
							| placeholder_svg_tag: 'placeholder-svg'
						}}
					{%- endif -%}
				{%- endif -%}
			</div>
			{%- if quickview_show -%}
				<div class='quick-add no-js-hidden'>
					{%- assign product_form_id = 'quick-add-'
						| append: section_id
						| append: product_card_product.id
					-%}
					<modal-opener data-modal='#QuickAdd-{{ product_card_product.id }}'>
						<button
							id='{{ product_form_id }}-submit'
							type='submit'
							name='add'
							class='card__link button--{{ settings.quickview_button_style }} js-color-swatches-link'
							aria-haspopup='dialog'
							aria-labelledby='{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}'
							data-product-url='{% if current_product.url != blank %}{{ current_product.url }}{% else %}{{ product_card_product.url | default: '#' }}{% endif %}'
						>
							<span>{{- 'general.card.quick__view' | t -}}</span>
							<div class='loading-overlay__spinner hidden'>
								<svg
									aria-hidden='true'
									focusable='false'
									role='presentation'
									class='spinner'
									viewBox='0 0 66 66'
									xmlns='http://www.w3.org/2000/svg'
								>
									<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
								</svg>
							</div>
						</button>
					</modal-opener>
					<quick-add-modal
						id='QuickAdd-{{ product_card_product.id }}'
						class='quick-add-modal'
					>
						<div
							role='dialog'
							aria-label='{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}'
							aria-modal='true'
							class='quick-add-modal__content global-settings-popup'
							tabindex='-1'
						>
							<button
								id='ModalClose-{{ product_card_product.id }}'
								type='button'
								class='quick-add-modal__toggle modal-close-button'
								aria-label='{{ 'accessibility.close' | t }}'
							>
								{% render 'icon-close' %}
							</button>
							<div class='quick-add-modal__content-wrapper'>
								<div
									id='QuickAddInfo-{{ product_card_product.id }}'
									class='quick-add-modal__content-info'
								></div>
							</div>
							{% comment %}
								<div class="quick-add-modal__announcement-bar">
									{{ settings.quickview }}
								</div>
							{% endcomment %}
						</div>
					</quick-add-modal>
				</div>
			{%- endif -%}
			
			<div 
				class='card__badge{% 
					if settings.badge_italic %} card__badge_italic{% endif %}{% 
					if current_product.compare_at_price > current_product.price and current_product.available %} on_sale{% 
					endif 
				%}'
			>
				{% if settings.badge_custom_show
					and product_card_product.metafields.custom.badges != blank
				%}
					<div class='card__badge-custom'>
						{% if product_card_product.metafields.custom.badges.list? %}
							{% for badge in product_card_product.metafields.custom.badges.value %}
								<span
									class='badge badge-text badge--custom'
									aria-hidden='true'
								>
									{{ badge }}
								</span>
							{% endfor %}
						{% else %}
							<span
								class='badge badge-text badge--custom'
								aria-hidden='true'
							>
								{{ product_card_product.metafields.custom.badges }}
							</span>
						{% endif %}
					</div>
				{% endif %}
				<div class='card__badge-standart'>
					{%- if current_product.available == false and current_product.compare_at_price > current_product.price -%}
						<span
							class='badge badge-text badge--bottom-left color-{{ settings.badge_icon_color }}'
							aria-hidden='true'
						>
							{{- 'products.product.sold_out' | t -}}
						</span>
					{%- elsif current_product.compare_at_price > current_product.price and current_product.available -%}
						<div
							class='badge badge-discount badge--bottom-left  color-{{ settings.badge_icon_color }}'
							aria-hidden='true'
						>
							{{
								current_product.price
								| minus: current_product.compare_at_price
								| times: 100
								| divided_by: current_product.compare_at_price
								| round: 0
								| split: '-'
								| join: ' '
							-}}
							<small>%</small>
						</div>

						<span
							class='badge badge-text badge--bottom-left color-{{ settings.badge_icon_color }}'
							aria-hidden='true'
						>
							{{- 'products.product.on_sale' | t -}}
						</span>
					{%- elsif current_product.available == false -%}
						<span
							class='badge not-available-sold-out badge-text badge--bottom-left color-{{ settings.badge_icon_color }}'
							aria-hidden='true'
						>
							{{- 'products.product.sold_out' | t -}}
						</span>
					{%- endif -%}
				</div>
			</div>
		</div>
		<a
			href='{% if current_product.url != blank %}{{ current_product.url }}{% else %}{{ product_card_product.url | default: '#' }}{% endif %}'
			class='link link--overlay card-wrapper__link--overlay card-product__link js-color-swatches-link'
			aria-label='link'
		></a>
	</div>

	<div class='card-information'>
		<div class='card-information__wrapper'>
			{%- if product_card_variant != blank and product_card_variant != null -%}
				{%- if show_sku and product_card_variant.sku.size > 0 -%}
					<p
						class='card__sku no-js-hidden'
						id='Sku-{{ section.id }}'
						role='status'
						{{ block.shopify_attributes }}
					>
						<span class='visually-hidden'>{{ 'products.product.sku' | t }}:</span>
						{{- product_card_variant.sku -}}
					</p>
				{%- endif -%}
			{%- else -%}
				{%- if show_sku and product_card_product.selected_or_first_available_variant.sku.size > 0 -%}
					<p
						class='card__sku no-js-hidden'
						id='Sku-{{ section.id }}'
						role='status'
						{{ block.shopify_attributes }}
					>
						<span class='visually-hidden'>{{ 'products.product.sku' | t }}:</span>
						{{- product_card_product.selected_or_first_available_variant.sku -}}
					</p>
				{%- endif -%}
			{%- endif -%}
			{%- if show_vendor -%}
				<span class='visually-hidden'>{{ 'accessibility.vendor' | t }}</span>
				<div class='caption-with-letter-spacing'>
					{{ product_card_product.vendor }}
				</div>
			{%- endif -%}
			<div class='card-title_info'>
				<div class='card__title'>
					<a
						style='text-transform: {{ settings.product_title_text_transform }}'
						class='full-unstyled-link js-color-swatches-link'
						href='{% if current_product.url != blank %}{{ current_product.url }}{% else %}{{ product_card_product.url | default: '#' }}{% endif %}'
						aria-label='link'
					>
						{%- if product_card_variant != blank and product_card_variant != null -%}
							{{ product_title }}
						{% elsif product_card_product != blank %}
							{{ product_card_product.title | escape }}
						{% else %}
							{{ 'products.product.product_heading' | t }}
						{% endif %}
					</a>
				</div>
				{%- if product_card_variant != blank and product_card_variant != null -%}
					{% render 'price',
						product: product_card_product,
						price_class: 'mini-price',
						use_variant: true,
						selected_variant: product_card_variant
					%}
				{%- else -%}
					{% render 'price',
						product: product_card_product,
						price_class: 'mini-price'
					%}
				{%- endif -%}
			</div>
			{%- if show_desc -%}
				{%- if product_card_variant.metafields.custom.variant_description.value != blank and product_card_variant.metafields.custom.variant_description != blank and product_card_variant.metafields.custom and product_card_variant != blank and product_card_variant != null -%}
					<div class='card__description'>
						{{ product_card_variant.metafields.custom.variant_description | metafield_tag }}
					</div>
				{%- elsif product_card_product.description != blank -%}
					<div class='card__description'>
						{{ product_card_product.description | strip_html | truncate: 220 }}
					</div>
				{%- endif -%}
			{%- endif -%}
		</div>
		{%- if product_card_variant != blank and product_card_variant != null -%}
			{% render 'price',
				product: product_card_product,
				price_class: 'wide-price',
				use_variant: true,
				selected_variant: product_card_variant
			%}
		{%- else -%}
			{% render 'price',
				product: product_card_product,
				price_class: 'wide-price'
			%}
		{%- endif -%}
		<div class='product-parameters no-js-hidden'>
			{%- if product_card_variant != blank and product_card_variant != null -%}
			{%- else -%}
				{%- unless product_card_product.has_only_default_variant -%}
					{%- for option in product_card_product.options_with_values -%}
						{% liquid
							assign color_trigger = settings.trigger_swatch | handle | strip
							assign name_option = option.name | handle | strip
						%}

						{% if settings.type_color_swatch == 'custom'
							and color_trigger == name_option
						%}
							<div class='product-form__controls js-color-swatches'>
								<div class='product-form__controls-group'>
									{% render 'product-variant-options',
										product: product_card_product,
										option: option,
										no_form_id: true
									%}
								</div>
							</div>
						{% endif %}
					{%- endfor -%}
				{% endunless %}
			{%- endif -%}
		</div>
	</div>
</div>
